# Requires the ActiveDirectory module for Get-ADComputer.
#Requires -Modules ActiveDirectory

# Clear the console and display the tool banner.
Clear-Host

Write-Host ""
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host " Windows Server Lifecycle Audit Tool" -ForegroundColor Cyan
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host ""

# Prompt for an export folder and create it when it does not exist.
# Output Folder
$ExportFolder = Read-Host "Enter export folder path"

if (-not (Test-Path $ExportFolder))
{
New-Item -Path $ExportFolder -ItemType Directory -Force | Out-Null
}

# Prompt the operator to choose CSV or Excel output.
Write-Host ""
Write-Host "Select export format:"
Write-Host "1 - CSV"
Write-Host "2 - Excel (XLSX)"
Write-Host ""

$Choice = Read-Host "Choice"

# Create timestamped output paths so existing reports are not overwritten.
$DateStamp = Get-Date -Format "yyyyMMdd_HHmmss"

$CsvFile = Join-Path $ExportFolder "ServerAudit_$DateStamp.csv"
$XlsxFile = Join-Path $ExportFolder "ServerAudit_$DateStamp.xlsx"

# Notify the operator that Active Directory discovery is starting.
Write-Host ""
Write-Host "Gathering server inventory from Active Directory..." -ForegroundColor Yellow
Write-Host ""

# Query Active Directory for computer objects whose operating system identifies them as Windows Server.
try
{
$Servers = Get-ADComputer `
-Filter "OperatingSystem -like '*Server*'" `
-Properties OperatingSystem |
Sort-Object Name
}
catch
{
Write-Host "Unable to query Active Directory." -ForegroundColor Red
Write-Host $_.Exception.Message
return
}

# Stop when the directory query returns no server objects.
if (!$Servers)
{
Write-Warning "No Windows Server objects found."
return
}

# Initialize the results collection and progress counters.
$Results = @()

$TotalServers = $Servers.Count
$Counter = 0

# Process each discovered server and update the progress indicator.
foreach ($Server in $Servers)
{
$Counter++

$PercentComplete = [Math]::Round(
(($Counter / $TotalServers) * 100),0
)

Write-Progress `
-Activity "Auditing Servers" `
-Status "$Counter of $TotalServers complete" `
-PercentComplete $PercentComplete

# Store the current server name for connectivity and CIM queries.
$ServerName = $Server.Name

# Test basic network reachability; record unavailable servers without attempting remote inventory.
if (-not (Test-Connection -ComputerName $ServerName -Count 1 -Quiet))
{
$Results += [PSCustomObject]@{
ServerName = $ServerName
Reachable = "No"
OperatingSystem = $Server.OperatingSystem
BuildNumber = ""
InstallDate = ""
YearsInService = ""
LastBootTime = ""
ServerType = ""
Manufacturer = ""
Model = ""
BIOSDate = ""
}

continue
}

# Collect operating system, hardware, and BIOS details from reachable servers through CIM.
try
{
$OS = Get-CimInstance `
Win32_OperatingSystem `
-ComputerName $ServerName `
-ErrorAction Stop

$CS = Get-CimInstance `
Win32_ComputerSystem `
-ComputerName $ServerName `
-ErrorAction Stop

$BIOS = Get-CimInstance `
Win32_BIOS `
-ComputerName $ServerName `
-ErrorAction Stop

# Use the operating system installation date to estimate years in service.
$InstallDate = $OS.InstallDate

$YearsOld = [Math]::Round(
(((Get-Date) - $InstallDate).Days / 365.25),
2
)

# Classify the server as virtual or physical from its reported model.
$ServerType =
if ($CS.Model -match "Virtual|VMware|Hyper-V|VirtualBox|KVM")
{
"Virtual"
}
else
{
"Physical"
}

# Add the successfully collected inventory data to the results collection.
$Results += [PSCustomObject]@{
ServerName = $ServerName
Reachable = "Yes"
OperatingSystem = $OS.Caption
BuildNumber = $OS.BuildNumber
InstallDate = $InstallDate
YearsInService = $YearsOld
LastBootTime = $OS.LastBootUpTime
ServerType = $ServerType
Manufacturer = $CS.Manufacturer
Model = $CS.Model
BIOSDate = $BIOS.ReleaseDate
}
}
# Record a collection error when a reachable server cannot return CIM data.
catch
{
$Results += [PSCustomObject]@{
ServerName = $ServerName
Reachable = "Error"
OperatingSystem = ""
BuildNumber = ""
InstallDate = ""
YearsInService = ""
LastBootTime = ""
ServerType = ""
Manufacturer = ""
Model = ""
BIOSDate = ""
}
}
}

# Close the progress display after all servers have been processed.
Write-Progress -Activity "Auditing Servers" -Completed

# Export the collected results in the format selected by the operator.
switch ($Choice)
{
# Export option 1: create a UTF-8 CSV report.
"1"
{
$Results |
Export-Csv `
-Path $CsvFile `
-NoTypeInformation `
-Encoding UTF8

Write-Host ""
Write-Host "CSV report created:" -ForegroundColor Green
Write-Host $CsvFile
}

# Export option 2: ensure ImportExcel is available, then create a formatted XLSX report.
"2"
{
if (-not (Get-Module -ListAvailable -Name ImportExcel))
{
Write-Host ""
Write-Host "Installing ImportExcel module..." -ForegroundColor Yellow

Install-Module `
-Name ImportExcel `
-Scope CurrentUser `
-Force
}

Import-Module ImportExcel

$Results |
Export-Excel `
-Path $XlsxFile `
-WorksheetName "Server Audit" `
-AutoSize `
-FreezeTopRow `
-BoldTopRow

Write-Host ""
Write-Host "Excel report created:" -ForegroundColor Green
Write-Host $XlsxFile
}

# Reject any unsupported export selection.
Default
{
Write-Warning "Invalid export selection."
return
}
}

# Calculate online and offline totals; array wrapping keeps Count reliable under strict mode.
$OnlineCount = @($Results | Where-Object { $_.Reachable -eq "Yes" }).Count
$OfflineCount = @($Results | Where-Object { $_.Reachable -eq "No" }).Count

# Display the overall audit summary.
Write-Host ""
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "SUMMARY" -ForegroundColor Cyan
Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "Servers Found : $TotalServers"
Write-Host "Online : $OnlineCount"
Write-Host "Offline : $OfflineCount"
Write-Host ""

# Display the ten servers with the greatest calculated years in service.
Write-Host "Oldest Servers:" -ForegroundColor Yellow

$Results |
Where-Object {$_.YearsInService -ne ""} |
Sort-Object YearsInService -Descending |
Select-Object -First 10 `
ServerName,
OperatingSystem,
YearsInService,
ServerType |
Format-Table -AutoSize

